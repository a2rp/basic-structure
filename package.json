{
    "name": "basic-structure",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "A Vite and React starter with client-side routing and GitHub Pages deployment",
    "author": "Ashish Ranjan",
    "license": "MIT",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "postbuild": "node -e \"const fs=require('fs');fs.copyFileSync('dist/index.html','dist/404.html')\"",
        "predeploy": "npm run build",
        "deploy": "npx gh-pages -d dist -b gh-pages"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.24.1",
        "styled-components": "^6.1.19"
    },
    "devDependencies": {
        "@eslint/js": "^9.25.0",
        "@vitejs/plugin-react": "^4.4.1",
        "eslint": "^9.25.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "gh-pages": "^6.3.0",
        "globals": "^16.0.0",
        "vite": "^6.3.5"
    }
}
